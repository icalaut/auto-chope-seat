{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auto-chope-seat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [{ "name": "BOOKINGS", "class_name": "BookingScheduler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookingScheduler"] }],
  "keep_vars": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "morning-brook-0ce0.cloudflareaccess.com",
    "ACCESS_AUD": "ae9822cbef4e530aca43981f4166a6d78de4abeb5f0539b0c94a9b2807bac658"
  },
  "observability": { "enabled": false }
}
